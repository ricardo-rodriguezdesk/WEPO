{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WEPO",
  "version": "0.3.0",
  "identifier": "com.ricardorodriguezarellano.wepo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WEPO",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Ricardo Rodríguez Arellano. Código abierto.",
    "shortDescription": "Escribe, edita y presenta: hojas de cálculo, documentos y presentaciones para Mac.",
    "longDescription": "WEPO (Write · Edit · Present · Open) es una suite de oficina de código abierto para macOS. WEPO Sheets abre y edita archivos .xlsx, .xls, .ods y .csv con fórmulas, formato, gráficas e imágenes.",
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "Documento de Word",
        "description": "Documento de Word",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "org.openxmlformats.wordprocessingml.document"
        ]
      },
      {
        "ext": [
          "odt"
        ],
        "name": "Documento de OpenDocument",
        "description": "Documento de texto de LibreOffice",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "org.oasis-open.opendocument.text"
        ]
      },
      {
        "ext": [
          "xlsx",
          "xlsm"
        ],
        "name": "Libro de Excel",
        "description": "Libro de Excel",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "org.openxmlformats.spreadsheetml.sheet",
          "org.openxmlformats.spreadsheetml.sheet.macroenabled"
        ]
      },
      {
        "ext": [
          "xls"
        ],
        "name": "Libro de Excel 97-2004",
        "description": "Libro de Excel 97-2004",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "com.microsoft.excel.xls"
        ]
      },
      {
        "ext": [
          "ods"
        ],
        "name": "Hoja de cálculo OpenDocument",
        "description": "Hoja de cálculo OpenDocument",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "org.oasis-open.opendocument.spreadsheet"
        ]
      },
      {
        "ext": [
          "csv"
        ],
        "name": "Valores separados por comas",
        "description": "Valores separados por comas",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "public.comma-separated-values-text"
        ]
      },
      {
        "ext": [
          "md"
        ],
        "name": "Documento Markdown",
        "description": "Documento Markdown",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "Documento PDF",
        "description": "Documento PDF",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "com.adobe.pdf"
        ]
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
